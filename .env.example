# Copy to .env (never commit .env)
SNOWFLAKE_ACCOUNT=orgname-accountname      # e.g. abcdefg-xy12345
SNOWFLAKE_USER=YOUR_USER
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=PIPELINE_WH
SNOWFLAKE_DATABASE=CDC_DEMO

# Auth: use ONE of the two
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Snowflake task schedule (how often the task checks the stream)
TASK_SCHEDULE=5 MINUTE
