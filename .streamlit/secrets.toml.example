# Copy to .streamlit/secrets.toml for local use (never commit it).
# On Streamlit Community Cloud, paste the same content under App settings > Secrets.
SNOWFLAKE_ACCOUNT = "orgname-accountname"
SNOWFLAKE_USER = "YOUR_USER"
SNOWFLAKE_PASSWORD = "YOUR_PASSWORD"
SNOWFLAKE_ROLE = "SYSADMIN"
SNOWFLAKE_WAREHOUSE = "PIPELINE_WH"
SNOWFLAKE_DATABASE = "CDC_DEMO"
TASK_SCHEDULE = "5 MINUTE"
# Optional: protect the dashboard with a password
APP_PASSWORD = "choose-a-password"
